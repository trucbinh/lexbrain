{
  "manifest_version": 3,
  "name": "LexBrain",
  "version": "1.1.2",
  "description": "Select text on any page, translate it, and save it as a flip card in LexBrain.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["contextMenus"],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Open LexBrain" }
}
