{
  "manifest_version": 3,
  "name": "LexBrain",
  "version": "1.2.4",
  "description": "Select text, then use the context menu to translate it and save it as a flip card in LexBrain.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["contextMenus"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.tatoeba.org/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open LexBrain" }
}
